# Generate a Mermaid entity-relationship diagram including classes outside the tree root
[group('model development')]
[arg("output", long)]
gen-graph $output="docs/generated/ontology-graph.md":
  #!/usr/bin/env bash
  set -euo pipefail
  diagram=$(gen-erdiagram --no-structural "{{source_schema_path}}")
  printf '# Ontology graph\n\nGenerated by `just gen-graph`. Do not edit.\n\n%s\n' "$diagram" | sed 's/[[:blank:]]*$//' > "$output"
